# Configuración de Supabase para HabitFlow Mobile
# Copia este archivo como `.env` o pasa los valores por `--dart-define-from-file=.env`
# Nunca subas tu archivo `.env` con credenciales reales a repositorios públicos.

SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-anon-key-publica-con-rls

